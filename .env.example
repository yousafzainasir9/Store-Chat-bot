# ============================================================================
# Store Chat Bot — environment template
# Copy to `.env` and fill in. NEVER commit a real `.env`. Every value here is a
# placeholder; nothing is hardcoded in the application.
# Nested settings use a double-underscore delimiter (e.g. FOO__BAR).
# ============================================================================

# ---- Core ----
ENVIRONMENT=development            # development | staging | production | test
DEBUG=false                        # must be false in production
APP_NAME=store-chat-bot
APP_VERSION=0.1.0
# Demo mode lets Phases 2-4 be built/tested without touching a real store.
DEMO_MODE=true
# Keep demo infra offline (synthetic catalog, in-memory store, hashing
# embedder) but route chat to the real provider configured below. Great for
# testing real model replies locally without Shopify/Qdrant/Postgres.
DEMO_USE_REAL_LLM=false

# ---- HTTP server ----
HOST=0.0.0.0
PORT=8000
# Comma-separated allowed origins. Lock to the storefront origin in production.
CORS_ORIGINS=*

# ---- Logging / observability ----
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true                      # false = pretty console logs in dev
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---- Datastores (optional in Phase 0; required from Phase 1/2) ----
# Local docker-compose values shown; the PaaS injects managed URLs in prod.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/storechat
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- LLM providers (Phase 1) ----
# NOTE: with DEMO_MODE=true the offline Fake model is used and these keys are
# ignored UNLESS DEMO_USE_REAL_LLM=true (real chat over the offline catalog).
# A full non-demo deployment (DEMO_MODE=false) always uses a real provider.
# Do NOT put an inline "# comment" after a value with no leading space — it
# becomes part of the value (e.g. MODEL=foo#bar sets the model to "foo#bar").
# Provider names (single-provider mode). Pick one for LLM_DEFAULT_PROVIDER:
#   openai | gemini | groq | grok (xai) | anthropic (claude)
#   mistral | deepseek | together | openrouter | fireworks   (set LLM_API_KEY)
#   ollama | vllm | openai_compatible | custom               (set LLM_BASE_URL)
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini      # e.g. groq: llama-3.1-8b-instant; claude: claude-3-5-sonnet-latest
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=                      # Groq (fast inference, keys start gsk_)
GROK_API_KEY=                      # xAI Grok (OpenAI-compatible, api.x.ai)
ANTHROPIC_API_KEY=                 # Anthropic Claude
# Generic OpenAI-compatible endpoint + key (Mistral/DeepSeek/Together/OpenRouter/
# Fireworks, or a local Ollama/vLLM server). LLM_BASE_URL overrides the default
# URL; required for openai_compatible/custom/vllm. Local servers need no key.
LLM_BASE_URL=                      # e.g. http://localhost:11434/v1 for Ollama
LLM_API_KEY=                       # fallback key for providers without a dedicated field
# Embeddings backend for retrieval. "auto" uses provider embeddings when the
# chat provider supports them (OpenAI/Gemini) and the offline hashing embedder
# otherwise. Groq has no embeddings API, so a Groq-only setup uses hashing.
EMBEDDING_BACKEND=auto             # auto | provider | hashing

# ---- LLM fallback chain (priority-ordered failover with cooldown) ----
# Define multiple providers/models/keys; lowest "priority" is tried first. When a
# provider hits its rate limit it is disabled for LLM_COOLDOWN_SECONDS (default
# 24h, the assumed free-tier refresh) and traffic fails over to the next.
# api_key_env names another env var that holds the key (keeps keys out of LLM_CHAIN).
# Example: three Groq free-tier keys, then OpenAI as a final fallback.
# (GROQ_API_KEY is declared above; these are extra keys for the chain.)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
LLM_COOLDOWN_SECONDS=86400
# LLM_CHAIN='[
#   {"provider":"groq","name":"groq-8b","model":"llama-3.1-8b-instant","api_key_env":"GROQ_API_KEY_1","priority":1},
#   {"provider":"groq","name":"groq-70b","model":"llama-3.3-70b-versatile","api_key_env":"GROQ_API_KEY_2","priority":2},
#   {"provider":"groq","name":"groq-3","model":"llama-3.1-8b-instant","api_key_env":"GROQ_API_KEY_3","priority":3},
#   {"provider":"openai","name":"openai","model":"gpt-4o-mini","api_key_env":"OPENAI_API_KEY","priority":4}
# ]' 

# ---- Shopify (Phase 2+) — custom app credentials ----
SHOPIFY_STORE_DOMAIN=              # e.g. your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=

# ---- Catalog freshness (Phase 2; see DEVELOPMENT_PLAN.md §7) ----
SYNC_PROFILE=balanced              # realtime | balanced | eco
STOCK_SOURCE=live                  # live | webhook  (keep live; quantity is volatile)
PRICE_RESOLUTION=live              # live | indexed  (final price resolved live)
CATALOG_SYNC_MODE=webhook          # webhook | poll
RECONCILE_DELTA_INTERVAL=1h        # 15m | 30m | 1h | 6h | 12h | 24h
RECONCILE_FULL_INTERVAL=24h
WEBHOOK_RETRY_MAX=5
STOCK_LOW_THRESHOLD=3              # force a live stock check at/below this qty
FAILSAFE_ON_API_ERROR=true         # on Shopify outage: decline + handoff, never guess
# Catalog import / embedding throughput (tunes cost + rate-limit headroom)
CATALOG_EMBED_BATCH_SIZE=128
CATALOG_IMPORT_CONCURRENCY=4

# ---- Live tools / orders (Phase 3) ----
RETURNS_ENABLED=false              # set true only after granting return scopes
EXCHANGES_ENABLED=false
REQUIRE_IDENTITY_VERIFICATION=true # email must match the order before any PII action

# ---- Human handoff (Phase 3) ----
HANDOFF_PROVIDER=logging           # logging | webhook
HANDOFF_WEBHOOK_URL=               # Gorgias/Zendesk/email-relay endpoint
HANDOFF_WEBHOOK_TOKEN=

# ---- Visual / multimodal search (Phase 5) ----
VISUAL_SEARCH_ENABLED=true
IMAGE_EMBEDDING_DIMENSION=512      # must match the image model; never mix with text dims
CLIP_MODEL_NAME=clip-ViT-B-32      # used only when DEMO_MODE=false (needs the `ml` extra)

# ---- Embeddable widget / abuse protection (Phase 6) ----
WIDGET_SECRET=                     # set to enable signed widget session tokens
WIDGET_TOKEN_TTL_SECONDS=3600
WIDGET_REQUIRE_TOKEN=false         # enforce the session token on /chat + /search/visual
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
SECURITY_HEADERS_ENABLED=true

# ---- Admin dashboard (Phase 7) ----
ADMIN_API_KEY=                     # bearer token for /admin/*; REQUIRED in production

# ---- Cost / abuse guards + compliance (Phase 8) ----
PER_SESSION_TOKEN_BUDGET=200000    # hard cap; over-budget sessions hand off
COST_ANOMALY_SESSION_THRESHOLD=50000  # soft threshold that emits a cost alert
DATA_RETENTION_DAYS=365            # conversations older than this are purged
